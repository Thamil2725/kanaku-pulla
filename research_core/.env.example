# Set these as environment variables; this package does not read another app's .env.
CORE_MODE=demo
CORE_DATA_DIR=runtime
CORE_TEAM_EMAILS=ap-team@team.local,research-team@team.local
# Explicit trusted local authorization file. Empty means no payments authorized.
# CORE_AUTHORIZATIONS=diligence_core/fixtures/authorizations.json
# CORE_REGISTRY=diligence_core/fixtures/registered_locations.json
CRUSTDATA_API_KEY=
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
# Standalone OpenRouter extraction. The embedded app reuses the host's reader settings.
OPENROUTER_API_KEY=
CORE_OPENROUTER_MODEL=
# Optional standalone Claude model; not required in the embedded app.
CORE_LLM_MODEL=
# Optional process-crash checkpoint: after_effect
CORE_CRASH_AT=

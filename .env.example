# Copy to .env and fill in. .env is ignored by git; never commit keys.
CRUSTDATA_API_KEY=

# Model that reads emails and writes the labelled summary (it never decides a payment).
# Set any of these; they are tried in order Gemini -> OpenRouter -> Claude, and if all fail the
# rule-based reader is used. Gemini keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force an order or turn models off (e.g. "openrouter,gemini" or "none").
KANAKU_LLM=
KANAKU_GEMINI_MODEL=gemini-3.5-flash-lite
KANAKU_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
KANAKU_MODEL=claude-opus-5-5

# Our own team only (hackathon rule: agents never contact anyone outside the team).
KANAKU_TEAM_EMAILS=ap-lead@kanaku.local,ops-lead@kanaku.local
KANAKU_AUTO_PAY_LIMIT_INR=500000
KANAKU_CACHE_MAX_AGE_HOURS=24

# Research uses the same KANAKU_LLM provider order and keys above; no separate Anthropic key.
# Demo verification uses fictional records. Live verification reuses the Crustdata key/credential loader.
KANAKU_RESEARCH_MODE=demo
# KANAKU_RESEARCH_DATA=research_data
# KANAKU_RESEARCH_REGISTRY=/absolute/path/to/trusted-location-register.json
GOOGLE_MAPS_API_KEY=
